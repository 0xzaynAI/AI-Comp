views:
  - type: table
    name: 表格
    filters:
      and:
        - file.inFolder("09_开源商机/项目库")
        - competitors != "不适用"
    order:
      - file.name
      - url
      - source
      - stars
      - category
      - scenario
      - select_reason
      - star_growth_weekly
      - research_done
      - reviewed
      - target_user
      - prd_started
      - competitors
      - problem
      - reject_reason
      - status
      - willingness_to_pay
      - mvp_feasibility
      - file.links
      - function
    sort:
      - property: problem
        direction: ASC
      - property: stars
        direction: DESC
    columnSize:
      file.name: 179
      note.url: 314
      note.stars: 91
      note.scenario: 320
      note.target_user: 114
      note.competitors: 116
      note.reject_reason: 119
  - type: cards
    name: 视图
