views:
  - type: table
    name: 表格
    filters:
      and:
        - file.inFolder("09_开源商机/项目库")
    order:
      - url
      - target_user
      - stars
      - star_growth_weekly
      - source
      - reviewed
      - research_done
      - file.path
      - file.name
    sort:
      - property: stars
        direction: DESC
    columnSize:
      note.stars: 91
  - type: cards
    name: 视图
